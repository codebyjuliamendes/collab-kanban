# Copy to .env and adjust. Every variable is optional.

# HTTP port and bind address.
PORT=3002
HOST=0.0.0.0

# Where the SQLite file (kanban.db) is stored. Must be writable and persistent.
DATA_DIR=./data

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Comma separated browser origins allowed to call the API / WebSocket from another site.
# Empty = same origin only (recommended).
ALLOWED_ORIGINS=

# When set (16+ characters), creating boards requires the header X-Admin-Token with this value.
# Leave empty to let anyone who can reach the server create boards.
BOARD_CREATION_TOKEN=

# Number of reverse proxies in front of the app (used for client IPs in rate limiting).
TRUST_PROXY=0

# Write requests per minute per IP on the REST API.
RATE_LIMIT_WRITES_PER_MINUTE=120

# Delay before the in-memory database is written to disk after a change (ms).
PERSIST_DEBOUNCE_MS=250

# Serve Swagger UI at /api-docs.
ENABLE_API_DOCS=true

# Host port used by docker-compose.
HOST_PORT=3002
