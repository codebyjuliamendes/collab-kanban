{
  "name": "collab-kanban",
  "version": "2.0.0",
  "private": true,
  "description": "Real-time collaborative Kanban board (Node.js, Express, WebSocket, SQLite)",
  "license": "MIT",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "board:invite": "node scripts/board-invite.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "pino": "^9.14.0",
    "sql.js": "^1.15.2",
    "swagger-ui-dist": "^5.34.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  }
}
